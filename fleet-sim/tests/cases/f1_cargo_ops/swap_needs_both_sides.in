# Simultaneous means the unloaded unit can't be the one loaded: a swap with an empty dock fails
# even if it would unload exactly what it loads.
{"command": "init", "parameters": {"travel_times": [[0,1],[1,0]], "dock_throughput": [5,5], "vessels": [{"id": "a", "location": 0}], "cargo_manifest": [{"location": 1, "destination": 1, "quantity": 1}]}}
{"command": "set_destination", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "tick", "parameters": {}}
{"command": "dock", "parameters": {"vessel_id": "a"}}
{"command": "tick", "parameters": {}}
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "tick", "parameters": {}}
# a carries [1], dock 1 is empty
{"command": "swap", "parameters": {"vessel_id": "a", "load_destination": 1, "unload_destination": 1}}
