# Cargo ops and undock in the same tick, in either order: cargo moves, then the vessel leaves.
{"command": "init", "parameters": {"travel_times": [[0,2,3],[2,0,1],[3,1,0]], "dock_throughput": [10,10,10], "vessels": [{"id": "a", "location": 0}, {"id": "b", "location": 0}], "cargo_manifest": [{"location": 0, "destination": 1, "quantity": 3}, {"location": 0, "destination": 2, "quantity": 1}]}}
{"command": "dock", "parameters": {"vessel_id": "a"}}
{"command": "dock", "parameters": {"vessel_id": "b"}}
{"command": "tick", "parameters": {}}
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "undock", "parameters": {"vessel_id": "a"}}
{"command": "undock", "parameters": {"vessel_id": "b"}}
{"command": "load", "parameters": {"vessel_id": "b", "destination": 2}}
{"command": "tick", "parameters": {}}
# both idle with their cargo; cargo ops now rejected (committed idle)
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
