# swap = simultaneous load + unload, both checked against the pre-swap inventories.
{"command": "init", "parameters": {"travel_times": [[0,2,3],[2,0,1],[3,1,0]], "dock_throughput": [10,10,10], "vessels": [{"id": "a", "location": 0}, {"id": "b", "location": 0}], "cargo_manifest": [{"location": 0, "destination": 1, "quantity": 3}, {"location": 0, "destination": 2, "quantity": 1}]}}
{"command": "dock", "parameters": {"vessel_id": "a"}}
{"command": "dock", "parameters": {"vessel_id": "b"}}
{"command": "tick", "parameters": {}}
{"command": "load", "parameters": {"vessel_id": "a", "destination": 2}}
{"command": "tick", "parameters": {}}
# a carries [2]; dock 0 has [1x3]. swap in a 1, swap out the 2
{"command": "swap", "parameters": {"vessel_id": "a", "load_destination": 1, "unload_destination": 2}}
# swapping back the 2 we just put on the dock is fine (planned inventory)
{"command": "swap", "parameters": {"vessel_id": "a", "load_destination": 2, "unload_destination": 1}}
# 2-for-2 swap: the only 2 is aboard (the swap above took it back), so there is nothing to load
{"command": "swap", "parameters": {"vessel_id": "a", "load_destination": 2, "unload_destination": 2}}
{"command": "tick", "parameters": {}}
