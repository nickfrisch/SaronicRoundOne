# Right after a tick, planned == committed, so get_state echoes the tick response exactly.
{"command": "init", "parameters": {"travel_times": [[0,3,1],[3,0,2],[1,2,0]], "vessels": [{"id": "a", "location": 0}, {"id": "b", "location": 2}]}}
{"command": "set_destination", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "set_destination", "parameters": {"vessel_id": "b", "destination": 0}}
{"command": "tick", "parameters": {}}
{"command": "get_state", "parameters": {}}
{"command": "tick", "parameters": {}}
{"command": "get_state", "parameters": {}}
