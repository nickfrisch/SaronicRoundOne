# Ops at one dock don't use another dock's budget.
{"command": "init", "parameters": {"travel_times": [[0,1],[1,0]], "dock_throughput": [1,1], "vessels": [{"id": "a", "location": 0}, {"id": "b", "location": 1}], "cargo_manifest": [{"location": 0, "destination": 1, "quantity": 2}, {"location": 1, "destination": 0, "quantity": 2}]}}
{"command": "dock", "parameters": {"vessel_id": "a"}}
{"command": "dock", "parameters": {"vessel_id": "b"}}
{"command": "tick", "parameters": {}}
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "load", "parameters": {"vessel_id": "b", "destination": 0}}
{"command": "load", "parameters": {"vessel_id": "b", "destination": 0}}
