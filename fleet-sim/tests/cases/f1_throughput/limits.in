# Throughput is per dock, shared by all vessels there, and resets every tick.
{"command": "init", "parameters": {"travel_times": [[0,1],[1,0]], "dock_throughput": [2,1], "vessels": [{"id": "a", "location": 0}, {"id": "b", "location": 0}], "cargo_manifest": [{"location": 0, "destination": 1, "quantity": 10}]}}
{"command": "dock", "parameters": {"vessel_id": "a"}}
{"command": "dock", "parameters": {"vessel_id": "b"}}
{"command": "tick", "parameters": {}}
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "load", "parameters": {"vessel_id": "b", "destination": 1}}
# third op across both vessels exceeds 2; state is unchanged by the rejection
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "get_state", "parameters": {}}
{"command": "tick", "parameters": {}}
# new tick, budget resets
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "load", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "load", "parameters": {"vessel_id": "b", "destination": 1}}
