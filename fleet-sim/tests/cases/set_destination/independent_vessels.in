# Commanding one vessel never affects another; a rejection for one doesn't block others.
{"command": "init", "parameters": {"travel_times": [[0,1,3],[1,0,1],[3,1,0]], "vessels": [{"id": "a", "location": 0}, {"id": "b", "location": 0}, {"id": "c", "location": 2}]}}
{"command": "set_destination", "parameters": {"vessel_id": "a", "destination": 2}}
{"command": "tick", "parameters": {}}
# a is in transit (rejected) but b and c are idle (accepted)
{"command": "set_destination", "parameters": {"vessel_id": "a", "destination": 1}}
{"command": "set_destination", "parameters": {"vessel_id": "b", "destination": 1}}
{"command": "set_destination", "parameters": {"vessel_id": "c", "destination": 0}}
{"command": "tick", "parameters": {}}
