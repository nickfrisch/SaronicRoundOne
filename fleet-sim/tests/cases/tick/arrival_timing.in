# A vessel arriving at tick T reports idle (at its destination) at tick T, never transit.
{"command": "init", "parameters": {"travel_times": [[0,1,3],[1,0,2],[3,2,0]], "vessels": [{"id": "fast", "location": 0}, {"id": "slow", "location": 0}]}}
{"command": "set_destination", "parameters": {"vessel_id": "fast", "destination": 1}}
{"command": "set_destination", "parameters": {"vessel_id": "slow", "destination": 2}}
# tick 1: fast (travel 1) has already arrived
{"command": "tick", "parameters": {}}
{"command": "tick", "parameters": {}}
# tick 3: slow arrives
{"command": "tick", "parameters": {}}
{"command": "tick", "parameters": {}}
